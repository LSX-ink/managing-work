 "reviews": [
  {
   "name": "places/ChIJFdq6qaZGiEgR_6iXeJty8Ks/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xSMlpYVk9Oa0pTYmswMVJFSk9WR1l6YkhaMWNVRRAB",
   "relativePublishTimeDescription": "a month ago",
   "rating": 5,
   "text": {
    "text": "I’ve been coming to Hair in the City for 10+ years and wouldn’t trust anyone else with my hair. The salon is professional and friendly. You can clearly see the care each of the stylists has for their clients and they always go the extra mile to make sure they are happy. I’m always impressed by the knowledge of the science behind colouring decisions. I always feel like I’m in safe hands when trying anything new, because I’ll know that the staff would never put the integrity of a clients hair at risk. I’ll continue to trust Louise and her stylists to cut and colour my hair for the foreseeable future.",
    "languageCode": "en"
   },
   "originalText": {
    "text": "I’ve been coming to Hair in the City for 10+ years and wouldn’t trust anyone else with my hair. The salon is professional and friendly. You can clearly see the care each of the stylists has for their clients and they always go the extra mile to make sure they are happy. I’m always impressed by the knowledge of the science behind colouring decisions. I always feel like I’m in safe hands when trying anything new, because I’ll know that the staff would never put the integrity of a clients hair at risk. I’ll continue to trust Louise and her stylists to cut and colour my hair for the foreseeable future.",
    "languageCode": "en"
   },
