   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21OTFJsa3pSRjlLY2pSTmJYWkNla280VDBkZlpHYxAB!2m1!1s0x1e957577eb72ec71:0x15b3d1e40d866411"
