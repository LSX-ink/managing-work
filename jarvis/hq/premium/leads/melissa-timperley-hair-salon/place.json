 "reviews": [
  {
   "name": "places/ChIJKYDpLrmxe0gRdfdUbb4XPQs/reviews/Ci9DQUlRQUNvZENodHljRjlvT2pkQ2RGUlRlVTlZVVRaVVkxcHFSV3R5WldFelZuYxAB",
   "relativePublishTimeDescription": "7 months ago",
   "rating": 5,
   "text": {
    "text": "I was at the Melissa Timperley salon for seven hours yesterday. The team there are great, really friendly and very supportive. At every point of my hair transformation journey I was consulted and felt very much part of all the decision-making.\nThe atmosphere in the salon is really warm and welcoming, a nice place to spend the day.  Special thanks to Ellie who did such a great job on my hair, I’m looking forward to the next session that we have together.",
    "languageCode": "en"
   },
   "originalText": {
    "text": "I was at the Melissa Timperley salon for seven hours yesterday. The team there are great, really friendly and very supportive. At every point of my hair transformation journey I was consulted and felt very much part of all the decision-making.\nThe atmosphere in the salon is really warm and welcoming, a nice place to spend the day.  Special thanks to Ellie who did such a great job on my hair, I’m looking forward to the next session that we have together.",
    "languageCode": "en"
   },
