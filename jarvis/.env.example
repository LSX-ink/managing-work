# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: ElevenLabs voice. Leave empty to use your browser's built-in voice.
ELEVENLABS_API_KEY=
# "George" (a calm British voice). Any voice ID from your ElevenLabs voice library works.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Leave empty to pick automatically: eleven_turbo_v2_5 where it speaks the language, else eleven_v3.
ELEVENLABS_MODEL=

# Who answers: "jarvis" (Iron Man's AI) or "alfred" (Batman's butler)
JARVIS_PERSONA=jarvis
# Look: classic (plain orb) or a HUD dashboard: hud, hud-gold, hud-purple, hud-red, hud-green, hud-stars
JARVIS_THEME=classic
# On the HUD: the 3D station world behind the panels (false = the plain background)
JARVIS_STATION=true
# Say exactly this when woken; {time_of_day} becomes morning, afternoon or evening.
# e.g. JARVIS_GREETING=Good {time_of_day}, sir.   Leave empty for a greeting with weather and tasks.
JARVIS_GREETING=

# About you
JARVIS_USER_NAME=
JARVIS_USER_ADDRESS=sir
JARVIS_CITY=London
# A Markdown file with "- [ ] task" checkboxes, e.g. an Obsidian note
JARVIS_TASKS_FILE=
# Currency for the money log, e.g. GBP, ZAR, USD
JARVIS_CURRENCY=GBP

# Language: speech recognition / voice code, and the language Jarvis replies in.
# For Afrikaans: JARVIS_SPEECH_LANG=af-ZA, JARVIS_LANGUAGE=Afrikaans, JARVIS_USER_ADDRESS=meneer
JARVIS_SPEECH_LANG=en-GB
JARVIS_LANGUAGE=English

# Model and effort (low keeps replies quick)
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=low
# auto: quick for small talk, more thought for plans, comparisons, money and code. Or low, medium, high
JARVIS_THINKING=auto

# Features
JARVIS_ENABLE_WEB=true
JARVIS_ENABLE_SCREEN=true
# Open apps, folders and files; media and volume keys; find and read files in your home folder
JARVIS_ENABLE_PC=true
# Mouse and keyboard control. You approve every click and keystroke on the page.
JARVIS_ENABLE_COMPUTER=false

# Ask for this password before the page opens. Leave empty for no password.
JARVIS_PASSWORD=
# Alfred only answers on localhost, IP addresses, your PC's name and the Tailscale phone link (*.ts.net).
# Any other web address you open him on goes here, comma separated (it blocks sneaky "DNS rebinding" sites)
JARVIS_ALLOWED_HOSTS=
# Memory folders (the wolf on the HUD). Empty keeps them in the memory folder next to server.py
JARVIS_MEMORY_DIR=

# New abilities: when Alfred can't do something, he sends the request to Claude as a GitHub issue on this repo,
# and Claude builds it as an update you merge. With a token (a fine-grained GitHub token with "Issues: read and
# write" on this repository only) it's sent automatically; leave it empty and Alfred opens the request in your
# browser for you to click Submit.
JARVIS_GITHUB_TOKEN=
JARVIS_GITHUB_REPO=LSX-ink/managing-work

# TikTok studio: Alfred makes each account's videos every day (from JARVIS_CREATOR_HOUR) and waits for your OK.
JARVIS_CREATOR_DAILY=true
JARVIS_CREATOR_HOUR=7
# Story narrator (free Microsoft voices), e.g. en-GB-RyanNeural, en-US-AndrewNeural, en-US-AvaNeural
JARVIS_CREATOR_VOICE=en-GB-RyanNeural
# To post approved videos by himself: a free app from https://developers.tiktok.com (Login Kit + Content
# Posting API, redirect address http://localhost:8340/tiktok/callback). Empty: videos are saved to upload by hand.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# draft = lands in your TikTok inbox to post from the app; direct = posts straight away (private until TikTok
# approves your app)
JARVIS_TIKTOK_MODE=draft
# Clip accounts (Clipzz) find viral clips with a free Twitch app from https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick clips (n3on.vault) are found without keys. Optional: an app from https://kick.com/settings/developer
# lets Alfred check the channel with Kick's official API first. Leave empty if you don't have one.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Delivery alerts from your email (Deliveroo, Just Eat, Uber Eats, Amazon, couriers).
# For Gmail, JARVIS_EMAIL_APP_PASSWORD is an app password from https://myaccount.google.com/apppasswords
# (needs 2-Step Verification), never your normal Gmail password. Leave both empty to turn this off.
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_APP_PASSWORD=
JARVIS_EMAIL_IMAP_HOST=imap.gmail.com
JARVIS_EMAIL_CHECK_SECONDS=60
# Alfred's own email account, used for every account he signs up for and on Kinetic Web Designs papers.
# Make it yourself (sign-up needs a phone check), then add an app password the same way as above.
# He only reads it (unread count, recent emails, sign-up codes); he never sends from it.
JARVIS_ALFRED_EMAIL_ADDRESS=
JARVIS_ALFRED_EMAIL_APP_PASSWORD=
# Announce phone calls and Deliveroo / Just Eat / Uber Eats app notifications (Windows + Phone Link)
JARVIS_PHONE_ALERTS=false
# Call alerts over the internet, no cable or Bluetooth. Jarvis makes up a private address and
# shows it in his messages; see "Calls over the internet" in the README. false turns it off.
JARVIS_CALL_ALERTS=true

# Keep 127.0.0.1 unless you know why you need otherwise: the server can see your screen.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8340

# Calendar (read-only): your calendar's private iCal (.ics) address. See "Calendar" in the README.
JARVIS_CALENDAR_URL=
