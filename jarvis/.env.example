# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: ElevenLabs voice. Leave empty to use your browser's built-in voice.
ELEVENLABS_API_KEY=
# "George" (a calm British voice). Any voice ID from your ElevenLabs voice library works.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Leave empty to pick automatically: eleven_turbo_v2_5 where it speaks the language, else eleven_v3.
ELEVENLABS_MODEL=

# About you
JARVIS_USER_NAME=
JARVIS_USER_ADDRESS=sir
JARVIS_CITY=London
# A Markdown file with "- [ ] task" checkboxes, e.g. an Obsidian note
JARVIS_TASKS_FILE=

# Language: speech recognition / voice code, and the language Jarvis replies in.
# For Afrikaans: JARVIS_SPEECH_LANG=af-ZA, JARVIS_LANGUAGE=Afrikaans, JARVIS_USER_ADDRESS=meneer
JARVIS_SPEECH_LANG=en-GB
JARVIS_LANGUAGE=English

# Model and effort (low keeps replies quick)
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=low

# Features
JARVIS_ENABLE_WEB=true
JARVIS_ENABLE_SCREEN=true

# Keep 127.0.0.1 unless you know why you need otherwise: the server can see your screen.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8340
